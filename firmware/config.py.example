# Copy to config.py on each Pico (SIM868 hardware and sampling only).
# Hardware: SIM868 on UART0, GP0=TX GP1=RX, PWRKEY GP14.
MODEM_UART = 0
MODEM_TX = 0
MODEM_RX = 1
MODEM_BAUD = 115200
# This carrier board requests power cycle: GP14 LOW 1 s, then HIGH held.
PWRKEY_PIN = 14
SAMPLE_SECONDS = 5
