# Copy this file to config.py on each Pico. Keep real credentials out of Git.
# One config.py now contains Wi-Fi, OTA, hardware and application settings.

# Common infrastructure Wi-Fi and OTA (publisher + receiver)
SSID = "rpi_network"
PASS = ""
HOST = "bts.ztk-comp.sk"

# BTS publisher: SIM868 hardware and sampling
MODEM_UART = 0
MODEM_TX = 0
MODEM_RX = 1
MODEM_BAUD = 115200
PWRKEY_PIN = 14
SAMPLE_SECONDS = 5

# Shared publisher <-> receiver AP settings
BTS_AP_SSID = "BTS-TRACKING"
BTS_AP_IP = "192.168.4.1"
BTS_TCP_PORT = 5000

# BTS receiver: MQTT upload over infrastructure Wi-Fi
MQTT_HOST = "mqtt.server.xx"
MQTT_PORT = 1883
MQTT_USER = "mqtt_user"
MQTT_PASS = "mqtt_password"
BTS_MQTT_TOPIC_PREFIX = "bts"

# BTS receiver: SD card SPI wiring
SD_SPI_ID = 0
SD_MISO_PIN = 16
SD_SCK_PIN = 18
SD_MOSI_PIN = 19
SD_CS_PIN = 17
SD_BAUDRATE = 10000000

# BTS receiver: button GPIOs (active-low)
KEY0_PIN = 15
KEY2_PIN = 2
KEY3_PIN = 3
